// /etc/apt/apt.conf.d/52homelab-unattended
// Reboot only when an update asks for it (/var/run/reboot-required), and then
// at night. With the apt-daily*.timer drop-ins, updates install at 03:00 and
// the reboot follows at 03:30 the same night.
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "03:30";
